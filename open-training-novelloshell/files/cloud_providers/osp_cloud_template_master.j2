      mac_address: "2c:c2:60:59:f1:53"
      
      port_security_enabled: False
      
      fixed_ips:
        - {subnet: {get_resource: Network0_subnet}, ip_address: "192.168.0.243"}
      



    
  floating_ip:
    type: OS::Neutron::FloatingIP
    properties:
      floating_network_id: { get_param: public_net_id }
    depends_on:
      - bastion.example.com_server

  association:
    type: OS::Neutron::FloatingIPAssociation
    properties:
      floatingip_id: { get_resource: floating_ip }
      port_id: { get_resource: bastion.example.com-0_port }

outputs:
  output_1:
    value: "Get pntae ssh private key (skip if you already have it): \n $ curl http://training1.gsslab.rdu2.redhat.com/pntae-training-ssh/pntae_training_key -o ~/.ssh/pntae_training_key\n $ chmod 600  ~/.ssh/pntae_training_key"
  output_2:
    description: Name of the instance.
    value: { get_attr: [ bastion.example.com_server, name ] }
  output_3:
    value: "ssh access:"
  output_4:
    description: IP address of the instance.
    value:
      list_join: ['', ['ssh -i ~/.ssh/pntae_training_key cloud-user@', { get_attr: [ floating_ip, floating_ip_address ] }]]


