heat_template_version: 2016-10-14
description: Create a project
parameters:
  public_net_id:
    type: string
    description: The ID for the floating ip
    default: external
  project_name:
    type: string
    default: {{ project_tag }}
    ##default: ""
    description: Name of the project for the flavors
  project_guid: 
    type: string
    default: {{ guid }}
    ##default: ""
  api_user:
    type: string
    default: ""
    description: User for API calls (i.e. ipmi)
  api_pass:
    type: string
    default: ""
    description: Password for API user
  api_url:
    type: string
    default: ""
    description: OSP URL for API calls
 
  pntae_lab:
    type: string
    default: "tech-breakfix-ha-001"
    description: pntae lab name
  pntae_lab_url:
    type: string
    default: "http://52.118.31.116/pntae-lab-setup-scripts/"
    description: pntae URL for injecting data

resources:
  openstack_project_infra_key:
    type: OS::Nova::KeyPair
    properties:
      name:
        str_replace:
          template: {{ project_tag }}-infra_key
          params:
             $project$: { get_param: project_guid }
      save_private_key: true
  Network0_network:
    type: OS::Neutron::Net
    properties:
      name: "Network0"
      shared: false
      value_specs: {"mtu": 1450}
  Network1_network:
    type: OS::Neutron::Net
    properties:
      name: "Network1"
      shared: false
      value_specs: {"mtu": 1450}
  Network0_subnet:
    type: OS::Neutron::Subnet
    properties:
      name: "sub-Network0"
      network_id: { get_resource: Network0_network }
      cidr: "192.168.0.0/24"
      gateway_ip: ""
      enable_dhcp: "False"
      
      dns_nameservers: [ "8.8.8.8", "8.8.4.4" ]

  Network1_subnet:
    type: OS::Neutron::Subnet
    properties:
      name: "sub-Network1"
      network_id: { get_resource: Network1_network }
      cidr: "172.16.100.0/24"
      gateway_ip: "172.16.100.1"
      enable_dhcp: "False"
      
      dns_nameservers: [ "8.8.8.8", "8.8.4.4" ]

  Router0_router:
    type: OS::Neutron::Router
    properties:
      name: "Router0"
      external_gateway_info: { "network": { get_param: public_net_id } }

  
  Router0_Network1_port:
    type: OS::Neutron::Port
    properties:
      network: { get_resource: Network1_network }
      fixed_ips:
        - ip_address: "172.16.100.1"
  
  Router0_Network1_router_if:
    type: OS::Neutron::RouterInterface
    properties:
        router: { get_resource: Router0_router }

        port: { get_resource: Router0_Network1_port }





  ####### bastion #######
  
  bastion.example.com_server:
    type: OS::Nova::Server
    properties:
      name: "bastion.example.com"
      
      image: "rhel7-ipmi-pntaecommon-prod"
      
      config_drive: True
      flavor: "GLOBAL-CPU_4_Memory_4096_Disk_10_flavor"
      
      key_name:  { get_resource: openstack_project_infra_key }
      
      metadata: 
        "guid": { get_param: project_guid }
        "description": "Instructor machine"

        ### ENTRIES FOR IPMI ###
        'api_user': { get_param: project_name }
        'api_pass': "redhat"
        'api_url': "https://api.red.sc01.infra.opentlc.com:13000"
        'project_name': { get_param: project_name }
        #'pxe_image': "pntae-pxeboot"
        'AnsibleGroup': "bastions"

        
        "hostname": 
          str_replace:
            template: "bastion-REPL"
            params:
              REPL: {get_param: project_guid}
        
      user_data_format: SOFTWARE_CONFIG
      user_data: {get_resource: bastion_config}            


      networks:
        
        - port: { get_resource: bastion.example.com-0_port}
        
        - port: { get_resource: bastion.example.com-1_port}
        

  bastion_config:
    type: OS::Heat::SoftwareConfig
    properties:
      config:
        str_replace: 
          params:
             $URL: { get_param: pntae_lab_url }
             $LAB: { get_param: pntae_lab }
             $VM: bastion
          template: |
            #!/bin/bash
            hostnamectl set-hostname bastion.example.com
            echo "shamrock masher positron tweet" | passwd cloud-user --stdin
            :> /etc/resolv.conf
            echo -e "nameserver 8.8.8.8" >> /etc/resolv.conf
            echo -e "nameserver 8.8.4.4" >> /etc/resolv.conf
            echo -e "\n\n\nLab environment deployment is IN PROGRESS... \nCheck /var/log/runcmd.out for status.\n\n\n" > /etc/motd
            sed -i '/requiretty/d' /etc/sudoers



            ##### SSH KEYS #####
            sudo -u cloud-user curl -o /home/cloud-user/.ssh/pntae_key http://pntae-training.psi.redhat.com/ssh-keys/pntae_key >> /var/log/runcmd.out 2>&1
            sudo -u cloud-user curl -o /home/cloud-user/.ssh/pntae_key.pub http://pntae-training.psi.redhat.com/ssh-keys/pntae_key.pub >> /var/log/runcmd.out 2>&1
            sudo -u cloud-user curl -o /home/cloud-user/.ssh/config http://pntae-training.psi.redhat.com/ssh-keys/config >> /var/log/runcmd.out 2>&1
            chmod 600 /home/cloud-user/.ssh/* >> /var/log/runcmd.out 2>&1
            sudo -u cloud-user cat /home/cloud-user/.ssh/pntae_key.pub >> /home/cloud-user/.ssh/authorized_keys


            ##### STARTUP SCRIPTS #####
            curl $URL/$LAB/$VM/bin/$LAB.sh -o /usr/local/bin/$LAB.sh  >> /var/log/runcmd.out 2>&1
            chmod a+x /usr/local/bin/*
            curl $URL/$LAB/$VM/ansible/playbook.yaml -o /tmp/playbook.yaml >> /var/log/runcmd.out 2>&1


            ##### ENTRY IN /etc/hosts FOR NAME RESOLUTION #####
            echo -e "172.16.100.10 bastion.example.com bastion" >> /etc/hosts
            echo -e "172.16.100.11 nodea.example.com nodea" >> /etc/hosts
            echo -e "172.16.100.12 nodeb.example.com nodeb" >> /etc/hosts
            echo -e "172.16.100.13 nodec.example.com nodec" >> /etc/hosts


            #echo -e "Waiting for a  minute..." >> /var/log/runcmd.out
            #sleep 60

            ##### Generate ansible hosts file using /etc/hosts entries #####
            awk 'NF>1{print $NF}' /etc/hosts > /etc/ansible/hosts
            ##### EXECUTE ANSIBLE PLAYBOOK #####
            sudo -u cloud-user ansible-playbook /tmp/playbook.yaml  >> /var/log/runcmd.out 2>&1

  
  bastion.example.com_services_sg:
    type: OS::Neutron::SecurityGroup
    properties:
      name: bastion.example.com_services_sg
      rules:
      
      - {port_range_max: 22, port_range_min: 22, protocol: tcp, remote_ip_prefix: 0.0.0.0/0}
      - {port_range_max: 65535, port_range_min: 1, protocol: tcp, remote_ip_prefix: 0.0.0.0/0}
      - {port_range_max: 65535, port_range_min: 1, protocol: udp, remote_ip_prefix: 0.0.0.0/0}
      
      - {direction: ingress, protocol: icmp}
      

  bastion.example.com-0_port:
    type: OS::Neutron::Port
    properties:
      network: { get_resource: Network1_network }
      mac_address: "2c:c2:60:3a:e9:00"
      
      security_groups:
        - bastion.example.com_services_sg
      
      
      fixed_ips:
        - {subnet: {get_resource: Network1_subnet}, ip_address: "172.16.100.10"}
      
    
    depends_on:
      
      
      - bastion.example.com_services_sg
      
    
  bastion.example.com-1_port:
    type: OS::Neutron::Port
    properties:
      network: { get_resource: Network0_network }
      mac_address: "2c:c2:60:59:f1:50"
      
      port_security_enabled: False
      
      fixed_ips:
        - {subnet: {get_resource: Network0_subnet}, ip_address: "192.168.0.240"}
      


